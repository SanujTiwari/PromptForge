# ============================================
# PromptForge - Environment Variables
# ============================================

# Database
DATABASE_URL=

# JWT
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Google OAuth (future)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (future)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (future)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (future)
AI_API_KEY=

# Frontend
VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY=
