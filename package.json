{
  "name": "promptforge",
  "version": "1.0.0",
  "description": "PromptForge - AI Prompt Marketplace",
  "private": true,
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "install:client": "cd client && npm install",
    "install:server": "cd server && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "prisma:generate": "cd server && npx prisma generate --schema=../prisma/schema.prisma",
    "prisma:push": "cd server && npx prisma db push --schema=../prisma/schema.prisma",
    "prisma:seed": "cd server && npm run db:seed",
    "prisma:studio": "cd server && npx prisma studio --schema=../prisma/schema.prisma"
  },
  "keywords": [
    "ai",
    "prompts",
    "marketplace"
  ],
  "license": "MIT",
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
